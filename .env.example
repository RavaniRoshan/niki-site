# Template — copy to .env.local and fill in. Do NOT commit real values.
# Formspree form id used by src/components/Waitlist.jsx (VITE_-prefixed so
# it is exposed to the client bundle).
VITE_WAITLIST_FORM=

# Formspree CLI deploy key (server-only, for `formspree deploy`). Keep out of
# client code. Only needed if you add formspree.json actions (e.g. Mailchimp).
FORMSPREE_DEPLOY_KEY=
